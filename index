// Smooth scroll
document.querySelectorAll('a[href^="#"]').forEach(a => {
  a.addEventListener('click', e => {
    const t = document.querySelector(a.getAttribute('href'));
    if (t) { e.preventDefault(); t.scrollIntoView({ behavior:'smooth' }); }
  });
});

// FORM SUBMIT
document.getElementById('leadForm').addEventListener('submit', async function(e) {
  e.preventDefault();

  const name   = document.getElementById('fname').value.trim();
  const phone  = document.getElementById('fphone').value.trim();
  const email  = document.getElementById('femail').value.trim();
  const budget = document.getElementById('fbudget').value;
  const date   = document.getElementById('fdate').value;

  if (!name || !phone) {
    document.getElementById('err').textContent = '❌ Name and Phone are required!';
    document.getElementById('err').style.display = 'block';
    return;
  }

  // Show loading
  document.getElementById('err').style.display = 'none';
  document.getElementById('spin').style.display = 'block';
  document.getElementById('fsubBtn').disabled = true;
  document.getElementById('fsubBtn').textContent = 'Submitting...';

  const formData = new FormData();
  formData.append('name', name);
  formData.append('phone', phone);
  formData.append('email', email);
  formData.append('budget', budget);
  formData.append('date', date);

  try {
    await fetch(SCRIPT_URL, { method:'POST', body: formData, mode:'no-cors' });
    // Redirect to thank you page
    window.location.href = 'thank-you.html';
  } catch (error) {
    document.getElementById('spin').style.display = 'none';
    document.getElementById('fsubBtn').disabled = false;
    document.getElementById('fsubBtn').textContent = '📅 Book My Free Site Visit →';
    document.getElementById('err').textContent = '❌ Submission failed. Please try again or call us directly.';
    document.getElementById('err').style.display = 'block';
  }
});
</script>
</body>
</html>
